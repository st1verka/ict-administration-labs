        "uid": "prometheus-kafka"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-kafka"
          },
          "expr": "up{job=\"kafka-exporter\"}",
